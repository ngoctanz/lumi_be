# MongoDB Atlas: paste the full connection string from Connect > Drivers.
# Use the DATABASE user's password, not an Atlas API key.
# Percent-encode special characters in username/password. Keep TLS enabled.
LUMI_MONGODB_URI="mongodb+srv://DB_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Lumi"
LUMI_MONGODB_DATABASE=lumi
LUMI_MONGODB_POOL_SIZE=10

LUMI_ENVIRONMENT=development
LUMI_CORS_ORIGINS=["http://localhost:5173","https://localhost"]
# Set real CDN hosts later, e.g. ["cdn.your-domain.com"]. No API URLs here.
LUMI_CDN_HOSTS=["github.com"]
LUMI_REGISTRATION_ENABLED=true
LUMI_SESSION_TTL_SECONDS=604800
LUMI_PAIRING_TTL_SECONDS=300
LUMI_REQUEST_MAX_BYTES=16384
LUMI_IMAGE_UPLOAD_MAX_BYTES=5242880
LUMI_IMAGE_ASSET_LIMIT=50

# Server-side only. Get the API secret from Cloudinary Console > API Keys.
LUMI_CLOUDINARY_CLOUD_NAME=your_cloud_name
LUMI_CLOUDINARY_API_KEY=your_api_key
LUMI_CLOUDINARY_API_SECRET=replace_me
LUMI_CLOUDINARY_FOLDER=lumi

# Tests use a separate local Mongo instance and random lumi_test_* databases.
# Never point this at your live database.
# LUMI_TEST_MONGODB_URI=mongodb://127.0.0.1:27018
