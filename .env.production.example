# Public DNS name pointing to this VPS. Do not include https:// or a path.
LUMI_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# MongoDB Atlas database user URI. Percent-encode special password characters.
LUMI_MONGODB_URI=mongodb+srv://DB_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Lumi
LUMI_MONGODB_DATABASE=lumi
LUMI_MONGODB_POOL_SIZE=10

# JSON arrays are required. Add the deployed web app and Capacitor origins.
LUMI_CORS_ORIGINS=["https://app.example.com","https://localhost","capacitor://localhost"]
LUMI_CDN_HOSTS=["github.com"]

LUMI_REGISTRATION_ENABLED=true
LUMI_SESSION_TTL_SECONDS=604800
LUMI_PAIRING_TTL_SECONDS=300
LUMI_REQUEST_MAX_BYTES=16384

# Optional image name used by all backend services.
LUMI_IMAGE=lumi-be:local
