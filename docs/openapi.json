  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "k": {
            "type": "integer",
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "K"
          },
          "d": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": -1.0,
            "title": "D"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "k",
          "d"
        ],
        "title": "Alert"
      },
      "BindingWrite": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "source_id": {
            "type": "string",
            "maxLength": 48,
            "minLength": 1,
            "title": "Source Id"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "maxProperties": 8,
            "title": "Params"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "source_id"
        ],
        "title": "BindingWrite"
      },
      "Claim": {
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id"
          },
          "code": {
            "type": "string",
            "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{10}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "device_id",
          "code"
        ],
        "title": "Claim"
      },
      "ConfigWrite": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Expected Revision"
